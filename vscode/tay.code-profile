  "name": "tay",
  "settings": "{\"settings\":\"{\\n  // ============================================================================\\n  // Editor - General\\n  // ============================================================================\\n  \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\",\\n  \\\"editor.formatOnSave\\\": true,\\n  \\\"editor.formatOnType\\\": false,\\n  \\\"editor.detectIndentation\\\": true,\\n  \\\"editor.insertSpaces\\\": true,\\n  \\\"editor.indentSize\\\": \\\"tabSize\\\",\\n\\n  // ============================================================================\\n  // Editor - Appearance\\n  // ============================================================================\\n  \\\"editor.fontFamily\\\": \\\"MesloLGS NF\\\",\\n  \\\"editor.fontSize\\\": 15,\\n  \\\"editor.fontLigatures\\\": true,\\n  \\\"editor.lineNumbers\\\": \\\"relative\\\",\\n  \\\"editor.minimap.enabled\\\": false,\\n  \\\"editor.renderWhitespace\\\": \\\"none\\\",\\n  \\\"editor.bracketPairColorization.enabled\\\": false,\\n  \\\"editor.cursorSmoothCaretAnimation\\\": \\\"off\\\",\\n  \\\"editor.accessibilitySupport\\\": \\\"off\\\",\\n\\n  // ============================================================================\\n  // Editor - Language-specific Formatting\\n  // ============================================================================\\n  \\\"[cpp]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"llvm-vs-code-extensions.vscode-clangd\\\",\\n  },\\n  \\\"[html]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"vscode.html-language-features\\\",\\n  },\\n  \\\"[java]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"redhat.java\\\",\\n  },\\n  \\\"[latex]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"James-Yu.latex-workshop\\\",\\n  },\\n  \\\"[markdown]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"DavidAnson.vscode-markdownlint\\\",\\n  },\\n  \\\"[python]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"ms-python.black-formatter\\\",\\n    \\\"editor.formatOnType\\\": true,\\n  },\\n  \\\"[xml]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"redhat.vscode-xml\\\",\\n  },\\n\\n  // ============================================================================\\n  // Files & Explorer\\n  // ============================================================================\\n  \\\"files.associations\\\": {\\n    \\\"*.css\\\": \\\"tailwindcss\\\",\\n    \\\"*.s\\\": \\\"asm-intel-x86-generic\\\",\\n  },\\n  \\\"explorer.confirmDelete\\\": false,\\n  \\\"explorer.confirmDragAndDrop\\\": false,\\n  \\\"explorer.confirmPasteNative\\\": false,\\n\\n  // ============================================================================\\n  // Git\\n  // ============================================================================\\n  \\\"git.autofetch\\\": true,\\n  \\\"git.confirmSync\\\": false,\\n  \\\"git.enableSmartCommit\\\": true,\\n  \\\"git.openRepositoryInParentFolders\\\": \\\"always\\\",\\n\\n  // ============================================================================\\n  // Terminal\\n  // ============================================================================\\n  \\\"terminal.integrated.fontFamily\\\": \\\"MesloLGS NF\\\",\\n  \\\"terminal.integrated.fontSize\\\": 15,\\n  \\\"terminal.external.osxExec\\\": \\\"iTerm\\\",\\n  \\\"terminal.integrated.env.osx\\\": {\\n    \\\"CW_NEW_SESSION\\\": \\\"1\\\",\\n    \\\"FIG_NEW_SESSION\\\": \\\"1\\\",\\n    \\\"Q_NEW_SESSION\\\": \\\"1\\\"\\n  },\\n  \\\"go.toolsManagement.autoUpdate\\\": true,\\n  \\\"javascript.updateImportsOnFileMove.enabled\\\": \\\"always\\\",\\n  \\\"typescript.updateImportsOnFileMove.enabled\\\": \\\"always\\\",\\n  \\\"makefile.configureOnOpen\\\": true,\\n\\n  // ============================================================================\\n  // Extension-specific Settings\\n  // ============================================================================\\n  // LaTeX Workshop\\n  \\\"latex-workshop.formatting.latex\\\": \\\"latexindent\\\",\\n  \\\"latex-workshop.formatting.latexindent.path\\\": \\\"/opt/homebrew/Cellar/latexindent/3.24.5/bin\\\",\\n\\n  // Live Sass Compile\\n  \\\"liveSassCompile.settings.generateMap\\\": false,\\n  \\\"liveSassCompile.settings.showOutputWindowOn\\\": \\\"Error\\\",\\n\\n  // LLDB\\n  \\\"lldb.library\\\": \\\"/Applications/Xcode.app/Contents/SharedFrameworks/LLDB.framework/Versions/A/LLDB\\\",\\n  \\\"lldb.suppressUpdateNotifications\\\": true,\\n\\n  // Vim\\n  \\\"vim.leader\\\": \\\"<Space>\\\",\\n  \\\"vim.insertModeKeyBindings\\\": [\\n    {\\n      \\\"before\\\": [\\\"j\\\", \\\"k\\\"],\\n      \\\"after\\\": [\\\"<ESC>\\\"],\\n    },\\n  ],\\n  \\\"vim.normalModeKeyBindings\\\": [\\n    {\\n      \\\"before\\\": [\\\"<leader>\\\", \\\"n\\\", \\\"h\\\"],\\n      \\\"after\\\": [\\\":nohl\\\"],\\n    },\\n    {\\n      \\\"before\\\": [\\\"<C-d>\\\"],\\n      \\\"after\\\": [\\\"<C-d>\\\", \\\"z\\\", \\\"z\\\"],\\n    },\\n    {\\n      \\\"before\\\": [\\\"<C-u>\\\"],\\n      \\\"after\\\": [\\\"<C-u>\\\", \\\"z\\\", \\\"z\\\"],\\n    },\\n  ],\\n\\n  // Todo Highlight\\n  \\\"todohighlight.isEnable\\\": true,\\n  \\\"todohighlight.keywords\\\": [\\n    {\\n      \\\"text\\\": \\\"TODO:\\\",\\n      \\\"color\\\": \\\"#191724\\\",\\n      \\\"backgroundColor\\\": \\\"#3e8fb0\\\",\\n      \\\"overviewRulerColor\\\": \\\"#3e8fb0\\\",\\n      \\\"border\\\": \\\"1px solid #3e8fb0\\\",\\n      \\\"borderRadius\\\": \\\"3px\\\",\\n    },\\n    {\\n      \\\"text\\\": \\\"FIXME:\\\",\\n      \\\"color\\\": \\\"#191724\\\",\\n      \\\"backgroundColor\\\": \\\"#f6c177\\\",\\n      \\\"overviewRulerColor\\\": \\\"#f6c177\\\",\\n      \\\"border\\\": \\\"1px solid #f6c177\\\",\\n      \\\"borderRadius\\\": \\\"3px\\\",\\n    },\\n  ],\\n\\n  // Test Explorer\\n  \\\"testExplorer.useNativeTesting\\\": true,\\n  \\\"workbench.iconTheme\\\": \\\"file-icons-colourless\\\",\\n  \\\"workbench.sideBar.location\\\": \\\"right\\\",\\n  \\\"workbench.startupEditor\\\": \\\"none\\\",\\n\\n  // ============================================================================\\n  // Security\\n  // ============================================================================\\n  \\\"security.promptForLocalFileProtocolHandling\\\": false,\\n  \\\"security.workspace.trust.untrustedFiles\\\": \\\"open\\\",\\n\\n  // ============================================================================\\n  // Cursor-specific\\n  // ============================================================================\\n  \\\"cursor.composer.textSizeScale\\\": 1.15,\\n  \\\"cursor.cpp.disabledLanguages\\\": [\\\"plaintext\\\", \\\"scminput\\\"],\\n  \\\"[c]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"llvm-vs-code-extensions.vscode-clangd\\\",\\n  },\\n  \\\"terminal.integrated.fontLigatures.enabled\\\": true,\\n  \\\"window.autoDetectColorScheme\\\": false,\\n  \\\"workbench.colorTheme\\\": \\\"Corduroy\\\",\\n  \\\"resharper.region.region\\\": \\\"Americas\\\",\\n  \\\"resharper.dataSharing.allowDataSharing\\\": false,\\n  \\\"[csharp]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"anysphere.csharp\\\",\\n  },\\n}\\n\"}",
  "keybindings": "{\"keybindings\":\"// Place your key bindings in this file to override the defaults\\n[\\n  {\\n    \\\"key\\\": \\\"cmd+1\\\",\\n    \\\"command\\\": \\\"-workbench.action.focusFirstEditorGroup\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+1\\\",\\n    \\\"command\\\": \\\"workbench.action.openEditorAtIndex1\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+1\\\",\\n    \\\"command\\\": \\\"-workbench.action.openEditorAtIndex1\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+2\\\",\\n    \\\"command\\\": \\\"workbench.action.openEditorAtIndex2\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+2\\\",\\n    \\\"command\\\": \\\"-workbench.action.openEditorAtIndex2\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+3\\\",\\n    \\\"command\\\": \\\"workbench.action.openEditorAtIndex3\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+3\\\",\\n    \\\"command\\\": \\\"-workbench.action.openEditorAtIndex3\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+4\\\",\\n    \\\"command\\\": \\\"workbench.action.openEditorAtIndex4\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+4\\\",\\n    \\\"command\\\": \\\"-workbench.action.openEditorAtIndex4\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+5\\\",\\n    \\\"command\\\": \\\"workbench.action.openEditorAtIndex5\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+5\\\",\\n    \\\"command\\\": \\\"-workbench.action.openEditorAtIndex5\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+6\\\",\\n    \\\"command\\\": \\\"workbench.action.openEditorAtIndex6\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+6\\\",\\n    \\\"command\\\": \\\"-workbench.action.openEditorAtIndex6\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+7\\\",\\n    \\\"command\\\": \\\"workbench.action.openEditorAtIndex7\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+7\\\",\\n    \\\"command\\\": \\\"-workbench.action.openEditorAtIndex7\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+8\\\",\\n    \\\"command\\\": \\\"workbench.action.openEditorAtIndex8\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+8\\\",\\n    \\\"c